{
  "name": "@icytown/scaffold-client",
  "version": "0.1.0",
  "description": "TypeScript HTTP client runtime for Scaffold generated services",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "Scaffold"
  ],
  "author": "MegaShow",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "6.0.3"
  }
}
