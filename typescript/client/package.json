{
  "name": "@icytown/scaffold-client",
  "version": "0.1.0",
  "description": "TypeScript HTTP client runtime for Scaffold generated services",
  "homepage": "https://github.com/megashow/scaffold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megashow/scaffold.git",
    "directory": "typescript/client"
  },
  "bugs": {
    "url": "https://github.com/megashow/scaffold/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "Scaffold"
  ],
  "author": "MegaShow",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "6.0.3"
  }
}
