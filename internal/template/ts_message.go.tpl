// Code generated by scaffold. DO NOT EDIT.
// versions:
{{- range .Versions }}
// 	{{ . }}
{{- end }}
// source: {{ .Source }}

{{ range .Imports }}
  import type {
    {{- range .Names }}
      {{ . }},
    {{- end }}
  } from "{{ .Path }}";
{{- end }}

{{ range .Enums }}
  {{ renderDocComment .Comment }}
  export enum {{ .Name }} {
    {{- $enum := . }}
    {{- range .Values }}
      {{- if .Comment }}
        {{ renderDocComment .Comment }}
      {{- end }}
      {{ trimPrefix .Name (printf "%s_" $enum.Name) }} = {{ .Number }},
    {{- end }}
  }
{{ end }}

{{ range .Messages }}
  {{ renderDocComment .Comment }}
  export interface {{ .Name }} {
    {{ range .Fields }}
      {{- if .Comment }}
        {{- renderDocComment .Comment }}{{ "\n" }}
      {{- end }}
      {{- .Name }}?: {{ renderTSType .Type }}{{ if .Repeated }}[]{{ end }};
    {{ end -}}
  }
{{ end }}
