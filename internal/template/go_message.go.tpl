// Code generated by scaffold. DO NOT EDIT.
// versions:
{{- range .Versions }}
// 	{{ . }}
{{- end }}
// source: {{ .Source }}

package {{ .Package }}

{{ if .Imports }}
  import (
    {{- range $i, $group := .Imports }}
      {{ if $i -}}
        {{- "\n" }}
      {{- end }}
      {{ range $group -}}
        "{{ . }}"
      {{ end -}}
    {{- end }}
  )
{{ end }}

{{- range .Enums }}
  {{ renderGoComment .Comment -}}
  type {{ .Name }} int32

  const (
    {{- $enum := . }}
    {{- range .Values }}
      {{ renderGoComment .Comment -}}
      {{ .Name }} {{ $enum.Name }} = {{ .Number }}
    {{- end }}
  )
{{ end }}

{{ range .Messages }}
  {{ renderGoComment .Comment }}
  type {{ .Name }} struct {
  {{ range .Fields }}
    {{- if contains .Comment "\n" }}
      {{- renderGoComment .Comment }}
    {{- end -}}
    {{ .Name }} {{ renderGoType .Type .Repeated }}
    {{- if not (contains .Comment "\n") -}}
      {{- renderGoComment .Comment -}}
    {{- end }}
  {{ end -}}
  }
{{ end }}
