{
  "name": "scaffold",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "run:example-ts-client": "pnpm --filter @icytown/scaffold-client build && node example/ts-client/main.ts",
    "run:example-ts-client-axios": "pnpm --filter @icytown/scaffold-client build && node example/ts-client-axios/main.ts",
    "run:example-ts-client-upload-file": "pnpm --filter @icytown/scaffold-client build && node example/ts-client-upload-file/main.ts",
    "test": "pnpm --filter @icytown/scaffold-client build && node --test",
    "test:coverage": "pnpm --filter @icytown/scaffold-client build && node --test --experimental-test-coverage --test-reporter spec --test-reporter-destination stdout --test-reporter lcov --test-reporter-destination coverage-typescript.info"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@icytown/scaffold-client": "workspace:*",
    "@types/node": "26.6.2",
    "axios": "^1.20.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
